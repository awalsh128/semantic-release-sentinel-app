{
  "name": "semantic-release-sentinel",
  "main": "worker.ts",
  "compatibility_date": "2026-11-21",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Sentinel",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../Dockerfile" } },
    },
  ],
  "durable_objects": { "bindings": [{ "name": "SENTINEL", "class_name": "Sentinel" }] },
  // Replaces the older "migrations" array; don't use both.
  "exports": { "Sentinel": { "type": "durable-object", "storage": "sqlite" } },
}
